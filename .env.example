# ==============================================================================
# 🚀 AUTOMATED TRANSIT SAFETY PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' in your local root directory:
#    cp .env.example .env
# 2. Fill in your local or cloud database connection strings and API keys below.
# 3. NEVER commit your actual '.env' file to Git history!
# ==============================================================================

# --- 1. SHARED DATABASE & STORAGE CONFIGURATION ---
# MongoDB Atlas Cloud URI or Local Docker Instance
MONGO_URI=mongodb://localhost:27017/transit_safety_platform
# MONGO_URI=mongodb+srv://admin:secure_password@cluster0.mongodb.net/transit_safety?retryWrites=true&w=majority

# File storage directory for compressed AI evidence snapshots (sharp)
SNAPSHOT_STORAGE_PATH=./storage/snapshots
MAX_SNAPSHOT_CACHE_SIZE_MB=500

# --- 2. PYTHON COMPUTER VISION AI ENGINE (FastAPI - Port 8000) ---
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0
# Directory path containing pre-trained Ultralytics YOLOv8 weights (.pt files)
MODEL_WEIGHTS_DIR=./webcam-monitoring-app/ai-service/models
# Hardware inference execution target: 'cpu', 'cuda', or 'mps'
INFERENCE_DEVICE=cpu
# Confidence threshold cutoffs for event triggering (0.00 to 1.00)
DROWSY_CONFIDENCE_THRESHOLD=0.35
CELLPHONE_CONFIDENCE_THRESHOLD=0.40
SMOKING_CONFIDENCE_THRESHOLD=0.45
SEATBELT_CONFIDENCE_THRESHOLD=0.50
HANDS_OFF_CONFIDENCE_THRESHOLD=0.50

# --- 3. TELEMATICS GATEWAY & STREAMING BACKEND (Node.js - Port 3001 / 5000) ---
STREAMING_BACKEND_PORT=3001
STREAMING_WS_PATH=/ws/stream
# Sliding-window cooldown duration in milliseconds to prevent alert spamming
EVENT_COOLDOWN_MS=10000
# Target URL for asynchronous HTTP connection pooling to FastAPI Engine
AI_INFERENCE_API_URL=http://localhost:8000/predict

# --- 4. FLEET PORTAL & MANAGEMENT BACKEND (Node.js - Port 3000) ---
FLEET_API_PORT=3000
# JWT Secret key for multi-tenant administrator authentication
JWT_SECRET=super_secret_enterprise_jwt_signing_key_change_me
JWT_EXPIRES_IN=24h

# --- 5. CONVERSATIONAL RAG ANALYTICS AGENT (Python - Port 8001) ---
RAG_SERVICE_PORT=8001
# LLM Provider API Key (Groq LLaMA or OpenAI)
GROQ_API_KEY=gsk_your_dummy_groq_api_key_here
OPENAI_API_KEY=sk-your_dummy_openai_api_key_here
# SentenceTransformer embedding vector dimensionality
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
MAX_RETRIEVAL_DOCS=25

# --- 6. AUTOMATED ALERT WORKFLOWS (n8n Webhook Endpoints) ---
N8N_WEBHOOK_URL=http://localhost:5678/webhook/violation-alert
ENABLE_EMAIL_ALERTS=true
ENABLE_TELEGRAM_ALERTS=true
